# ---- Copy this file to .env and fill in your own values ----

# Database. Defaults to a local SQLite file if left blank - zero setup needed.
# For Postgres (Supabase/Neon), use: postgresql+psycopg2://user:pass@host:port/dbname
DATABASE_URL=sqlite:///./morning_brief.db

# Auth
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# Groq LLM (free, no credit card) - https://console.groq.com/keys
# Uses open-weight models only. Groq periodically retires older models -
# check https://console.groq.com/docs/models if this ever 404s.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Independent second-opinion verifier (a DIFFERENT provider from Groq on purpose,
# per the multi-layer verification design - free, no credit card):
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# Google Sign-In for both users and admins. Free - create a Web application
# OAuth Client ID at https://console.cloud.google.com/apis/credentials
# Add your frontend URL (e.g. http://localhost:5173 and your deployed URL)
# under "Authorized JavaScript origins". Leave blank to disable Google login
# entirely - email/password login keeps working either way.
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Brevo transactional email (free tier) - https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM_ADDRESS=news@yourdomain.com
EMAIL_FROM_NAME=Morning Brief

# Secret shared with your GitHub Actions cron workflows to authorize scheduled calls
CRON_SECRET=change-this-to-a-long-random-string

# URL of your deployed frontend (used in email links + CORS)
FRONTEND_URL=http://localhost:5173

# First admin account, auto-created on first startup if it doesn't exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
