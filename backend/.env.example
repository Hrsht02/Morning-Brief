# Copy to .env and fill every production secret.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./morning_brief.db

JWT_SECRET_KEY=generate-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite
GOOGLE_CLIENT_ID=your_google_oauth_client_id

BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM_ADDRESS=news@yourdomain.com
EMAIL_FROM_NAME=Morning Brief

CRON_SECRET=generate-another-long-random-secret
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password

# Production: set ENVIRONMENT=production. Startup rejects insecure defaults.
